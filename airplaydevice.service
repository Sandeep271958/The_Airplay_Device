[Unit]
Description=AirPlay/Bluetooth Audio Receiver Controller
After=network-online.target sound.target shairport-sync.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/sandypi/Airplaydevice/venv/bin/python /home/sandypi/Airplaydevice/main.py
WorkingDirectory=/home/sandypi/Airplaydevice
Restart=on-failure
RestartSec=5
# Root is required for SPI (WS2812) and GPIO access
User=root

[Install]
WantedBy=multi-user.target
