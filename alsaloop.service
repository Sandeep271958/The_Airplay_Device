[Unit]
Description=ALSA Loopback to DAC relay (via softvol)
After=sound.target
Requires=sound.target

[Service]
Type=simple
# Relay audio from the shared loopback capture to the DAC through softvol.
#   -C loopcapture   : read from dsnoop on hw:Loopback,1,0
#   -P softvol_out   : write to softvol (Headphones on 4B or I2S DAC on Zero 2 W)
#   -c 2             : 2-channel stereo
#   -r 44100         : 44.1kHz sample rate
#   -f S16_LE        : 16-bit little-endian
#   -t 150000        : 150ms buffer latency (eliminates buffer underruns)
ExecStart=/usr/bin/alsaloop -C loopcapture -P softvol_out -c 2 -r 44100 -f S16_LE -t 150000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
