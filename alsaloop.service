[Unit]
Description=ALSA Loopback to DAC relay (via softvol)
After=sound.target
Requires=sound.target

[Service]
Type=simple
# Relay audio from the shared loopback capture to the DAC through softvol.
#   -C loopcapture   : read from dsnoop on hw:Loopback,1,0
#   -P softvol_out   : write to softvol (Headphones or I2S DAC)
#   -c 2             : 2-channel stereo
#   -r 44100         : LOCK sample rate to 44.1kHz (eliminates 48kHz chipmunk pitch upshift)
#   -f S16_LE        : 16-bit little-endian CD quality
#   -t 120000        : 120ms target latency (eliminates buffer starvation & dropouts)
#   -S samplerate    : adaptive libsamplerate clock sync (eliminates pitch warbling)
#   -A sincfastest   : sinc interpolation algorithm for pristine resampling
#   -n               : enable ALSA library rate conversion
ExecStart=/usr/bin/alsaloop -C loopcapture -P softvol_out -c 2 -r 44100 -f S16_LE -t 120000 -S samplerate -A sincfastest -n
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
